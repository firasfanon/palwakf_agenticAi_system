{
  "contract_id": "STRUCTURED_ANALYSIS_PAYLOAD_KNOWLEDGE_RESEARCHER_V1",
  "version": "1.0.0",
  "role": "knowledge_researcher",
  "raw_output_format": "SINGLE_JSON_OBJECT",
  "max_raw_utf8_bytes": 12288,
  "required_top_level_keys": [
    "schema_version",
    "role",
    "analysis_status",
    "facts",
    "assumptions",
    "evidence_gaps",
    "risks_and_constraints",
    "source_assessments",
    "recommended_next_step"
  ],
  "static_values": {
    "schema_version": "1.0.0",
    "analysis_status": "PENDING_HUMAN_REVIEW",
    "recommended_next_step": "HUMAN_REVIEW_REQUIRED"
  },
  "limits": {
    "facts_min": 1,
    "facts_max": 4,
    "text_max_chars": 480,
    "list_max": 5,
    "list_item_max_chars": 360,
    "source_assessments_min": 1,
    "source_assessments_max": 4
  },
  "fact_item_keys": [
    "statement",
    "evidence_reference_ids"
  ],
  "source_assessment_item_keys": [
    "evidence_reference_id",
    "assessment",
    "trust_state"
  ],
  "source_assessment_trust_state": "REFERENCE_CONTENT_ONLY",
  "host_owned_fields": [
    "envelope_id",
    "run_id",
    "task_id",
    "agent_id",
    "evidence_manifest_id",
    "validated_at_utc",
    "validation_result"
  ],
  "forbidden_model_fields": [
    "task_id",
    "run_id",
    "envelope_id",
    "validation_result",
    "OUTPUT_CONTRACT_START",
    "OUTPUT_CONTRACT_END",
    "STRUCTURED_ANALYSIS_PAYLOAD_START",
    "STRUCTURED_ANALYSIS_PAYLOAD_END"
  ],
  "additional_keys_allowed": false
}
